{
  "prChecks": {
    "ignore": [
      "notify"
    ]
  },
  "checks": [
    "npm ci",
    "npm run typecheck",
    "npm run lint",
    "npm test",
    "npm run build"
  ],
  "release": {
    "versionFiles": [
      {
        "path": "package.json",
        "pointers": [
          "/version"
        ]
      },
      {
        "path": "package-lock.json",
        "pointers": [
          "/version",
          "/packages//version"
        ]
      }
    ]
  }
}
