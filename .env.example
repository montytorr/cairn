# ---------------------------------------------------------------------------
# Cairn — example environment. Copy to .env.local and fill in.
# Never commit a filled-in copy: .env* is gitignored except this file.
# ---------------------------------------------------------------------------

# Public base URL of your Cairn instance
CAIRN_BASE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# From your Supabase project (hosted) or your self-hosted stack's generated keys.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. If the app and Supabase share a Docker network, point server-side
# calls straight at the gateway rather than back out through the proxy.
# e.g. http://supabase-api-gw:8000
SUPABASE_INTERNAL_URL=

# Direct Postgres connection, used only by the migration runner.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Storage ----------------------------------------------------------------
# Private Supabase Storage bucket for task attachments.
CAIRN_ATTACHMENT_BUCKET=attachments
CAIRN_ATTACHMENT_MAX_BYTES=10485760

# --- Deployment (only needed when running behind a reverse proxy) -----------
# The hostname your instance is served on, e.g. cairn.example.com
CAIRN_DOMAIN=cairn.example.com
# External Docker network your reverse proxy already runs on.
CAIRN_PROXY_NETWORK=web

# --- CLI --------------------------------------------------------------------
# Used by the `cairn` CLI and by agents. Create a key in Settings -> API keys.
# One key per agent, so writes are attributable and any one can be revoked.
CAIRN_API_KEY=
